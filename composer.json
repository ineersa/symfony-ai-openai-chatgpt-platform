{
    "name": "ineersa/symfony-ai-openai-chatgpt-platform",
    "description": "Single-account Sign in with ChatGPT OAuth and HTTP Responses bridge for Symfony AI.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.11 || ^7.0",
        "league/oauth2-client": "^2.8",
        "psr/log": "^3.0",
        "symfony/ai-platform": "^0.14",
        "symfony/ai-open-responses-platform": "^0.14",
        "symfony/clock": "^8.0",
        "symfony/console": "^8.1",
        "symfony/filesystem": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/lock": "^8.0",
        "symfony/process": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/cache": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Platform\\Bridge\\OpenAIChatGPT\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\Platform\\Bridge\\OpenAIChatGPT\\Tests\\": "tests/"
        }
    }
}
